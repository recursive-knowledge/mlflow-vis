# Copy to .env, then run `make install` — it fills every blank secret below.
#   cp .env.example .env && make install
#
# .env is gitignored and chmod 600. Blank values are generated; non-blank
# values are never overwritten.

# ---------------------------------------------------------------- storage --
# All persistent state lives here. Nothing durable is stored in this repo.
#   supabase/db/       Postgres PGDATA (runs, metrics, checkpoint pointers)
#   supabase/storage/  artifact bucket bytes
#   checkpoints/       rsync target for model weights (large)
#   backups/           pg_dump output, daily + weekly
RK_DATA_ROOT=/overflow/recursive-knowledge

# --------------------------------------------------------------- postgres --
POSTGRES_DB=postgres
POSTGRES_PASSWORD=
# MLflow gets a separate database and role in the same cluster.
MLFLOW_DB_PASSWORD=

# --------------------------------------------------------------- supabase --
JWT_SECRET=
JWT_EXPIRY=3600
# Derived from JWT_SECRET — regenerated automatically if it changes.
ANON_KEY=
SERVICE_ROLE_KEY=
PGRST_DB_SCHEMAS=public,storage

# Storage / S3-compatible endpoint that MLflow writes artifacts to.
REGION=local
STORAGE_TENANT_ID=rk
GLOBAL_S3_BUCKET=stub
MLFLOW_BUCKET=mlflow
# The address MLflow signs S3 requests against. Changing this without
# changing MLFLOW_S3_ENDPOINT_URL breaks artifact logging.
STORAGE_INTERNAL_URL=http://storage:5000
S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=
# 5 GiB. Weights normally travel by rsync, not through here.
STORAGE_FILE_SIZE_LIMIT=5368709120

# Studio (admin console only — MLflow is the visualization surface).
# Loopback-bound on purpose; reach it with `make studio`.
STUDIO_BIND_ADDR=127.0.0.1
STUDIO_PORT=8000
STUDIO_DEFAULT_ORGANIZATION=recursive-knowledge
STUDIO_DEFAULT_PROJECT=rk-mlflow
SUPABASE_PUBLIC_URL=http://localhost:8000
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
PG_META_CRYPTO_KEY=

# ----------------------------------------------------------------- mlflow --
MLFLOW_WORKERS=4
# MLflow 3 rejects requests whose Host header is not listed here (DNS-rebinding
# guard). Host matching includes the port, so list both forms. It MUST
# include MLFLOW_HOSTNAME or every request through the tunnel
# 403s — while /health keeps returning 200, so the stack looks fine.
MLFLOW_ALLOWED_HOSTS=localhost,localhost:5000,127.0.0.1,127.0.0.1:5000,mlflow.example.com
MLFLOW_CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,https://mlflow.example.com

# Loopback only — the tunnel is the public path. Set to 10.0.0.8 to also
# serve on the WireGuard network.
MLFLOW_BIND_ADDR=127.0.0.1
MLFLOW_PORT=5000

# ------------------------------------------------------------- cloudflare --
# Public hostname the tunnel serves. Point its dashboard ingress at
# http://mlflow:5000 and nothing else.
MLFLOW_HOSTNAME=mlflow.example.com
# Zero Trust > Networks > Tunnels > (your tunnel) > install token.
# A credential in its own right: it authorizes an outbound tunnel.
CLOUDFLARE_TUNNEL_TOKEN=
# Optional — only `make node-token` needs it. Create at
# dash.cloudflare.com/profile/api-tokens with two ACCOUNT-scoped permissions:
#   Access: Service Tokens > Edit    Access: Apps and Policies > Edit
# The tunnel's own cert.pem cannot do this; it is 403 on every Access endpoint.
# Leave blank to issue node tokens by hand in the dashboard instead.
CLOUDFLARE_API_TOKEN=

# ---------------------------------------------------- checkpoint transport --
# Checkpoints never touch the tunnel. Nodes rsync over SSH to this account.
CKPT_SSH_HOST=10.0.0.8
CKPT_SSH_USER=atharvas
CKPT_SSH_PORT=22

# ------------------------------------------------------------- retention ---
# /overflow is shared and near capacity — these are enforced, not advisory.
CKPT_KEEP_LAST=3
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=8
DISK_WARN_GB=200
